# Supabase project — create your own at https://supabase.com and paste the values here.
# Copy to .env.local. Never commit .env.local; the anon key is public but still belongs in env, not source.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Development only. Set to 1 to render the portal shell without a backend so the
# RTL layout can be reviewed. Ignored in production builds.
VITE_PORTAL_PREVIEW=
