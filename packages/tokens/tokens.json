      "500": "#14806b",
      "600": "#0c6e5c",
      "700": "#0a5949",
      "800": "#084437",
      "900": "#062e26"
    },
    "accent": {
      "100": "#fdefd6",
      "300": "#f4c784",
      "500": "#e8963a",
      "600": "#cc7a1f",
      "700": "#a35f16"
    },
    "ink": {
      "400": "#6b7f8c",
      "500": "#4a5e6b",
      "600": "#2d4150",
      "800": "#16232e",
      "900": "#0d1720"
    },
    "surface": {
      "canvas": "#f4f7f8",
      "card": "#ffffff",
      "sand": "#fbf7f0",
      "line": "#dfe7ea"
    },
    "state": {
      "warningBg": "#fdf0d8",
      "warningFg": "#93600f",
      "dangerBg": "#fde8e8",
      "dangerFg": "#c0392b"
    }
  },
  "radius": {
    "card": 14,
    "control": 10,
    "pill": 999
