{
  "$schema": "https://raw.githubusercontent.com/amzn/style-dictionary/main/schemas/config.json",
  "name": "e7gezly-tokens",
  "description": "Single source of truth for brand values. Consumed by Flutter (apps/mobile) and the portal (apps/web). Changing a value here is the only sanctioned way to change brand appearance.",
  "color": {
    "brand": {
      "50": "#eaf6f3",
      "100": "#cfe9e2",
      "200": "#a3d5c8",
      "300": "#6bb9a7",
      "400": "#359a83",
      "500": "#14806b",
      "600": "#0c6e5c",
      "700": "#0a5949",
      "800": "#084437",
      "900": "#062e26"
    },
    "accent": {
      "100": "#fdefd6",
      "300": "#f4c784",
      "500": "#e8963a",
      "600": "#cc7a1f",
      "700": "#a35f16"
    },
    "ink": {
      "400": "#6b7f8c",
      "500": "#4a5e6b",
      "600": "#2d4150",
      "800": "#16232e",
      "900": "#0d1720"
    },
    "surface": {
      "canvas": "#f4f7f8",
      "card": "#ffffff",
      "sand": "#fbf7f0",
      "line": "#dfe7ea"
    },
    "state": {
      "warningBg": "#fdf0d8",
      "warningFg": "#93600f",
      "dangerBg": "#fde8e8",
      "dangerFg": "#c0392b"
    },
    "select": {
      "note": "One selected state everywhere: chips, menu items, active filters. Brand-derived, never the Material default (which resolves to the orange accent).",
      "bg": "#cfe9e2",
      "fg": "#0a5949",
      "outline": "#14806b"
    }
  },
  "radius": {
    "card": 14,
    "control": 10,
    "pill": 999
  },
  "elevation": {
    "note": "Shadows tint color.ink.900 at these alphas - no grey haze. Applied by E7Card and any raised surface.",
    "card": {
      "offsetY": 1,
      "blur": 4,
      "alpha": 0.06
    },
    "raised": {
      "offsetY": 6,
      "blur": 20,
      "alpha": 0.14
    }
  },
  "control": {
    "note": "Touch targets for the customer app. The desktop portal keeps Ant Design's own density and borrows only the selected state and radii.",
    "height": 50,
    "heightSecondary": 44,
    "iconBubble": 44
  },
  "icon": {
    "note": "Brand mark. Rendered by tools/make-icons.ps1 — the PNGs in the apps are generated output, never hand-edited.",
    "glyph": "ح",
    "gradientTop": "#20967c",
    "gradientBottom": "#073b31",
    "foreground": "#fbf7f0",
    "cornerRatio": 0.22,
    "glyphRatio": 0.58,
    "adaptiveGlyphRatio": 0.40
  },
  "space": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48
  },
  "typography": {
    "fontFamilyDisplay": "Cairo",
    "fontFamilyText": "IBM Plex Sans Arabic",
    "fallback": ["Segoe UI", "Tahoma", "system-ui", "sans-serif"],
    "baseSize": 16,
    "lineHeight": 1.7,
    "displayLineHeight": 1.35,
    "navTitleSize": 20,
    "chipLabelSize": 13
  },
  "layout": {
    "direction": "rtl",
    "locale": "ar-EG",
    "currency": "EGP",
    "currencyDisplay": "ج.م",
    "digits": "latn",
    "maxContentWidth": 1200,
    "cardGridMinContentWidthForTwoColumns": 420,
    "categoryTileHeight": 104
  }
}
