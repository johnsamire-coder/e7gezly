    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48
  },
  "typography": {
    "fontFamilyDisplay": "Cairo",
    "fontFamilyText": "IBM Plex Sans Arabic",
    "fallback": ["Segoe UI", "Tahoma", "system-ui", "sans-serif"],
    "baseSize": 16,
    "lineHeight": 1.7
  },
  "layout": {
    "direction": "rtl",
    "locale": "ar-EG",
    "currency": "EGP",
    "currencyDisplay": "ج.م",
    "digits": "latn",
    "maxContentWidth": 1200
  }
